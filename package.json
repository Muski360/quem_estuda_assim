{
  "name": "quem_estuda_assim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/local-env.mjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --import ./scripts/local-env.mjs node_modules/next/dist/bin/next start",
    "login:supabase": "supabase login",
    "login:cloudflare": "wrangler login",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/deploy-worker.mjs",
    "db:push": "node scripts/apply-migrations.mjs",
    "test:deployment": "node scripts/test-deployment.mjs",
    "check:secrets": "node scripts/check-worker-secrets.mjs",
    "enem:download": "node scripts/enem/download.mjs",
    "enem:validate": "python scripts/enem/validate.py",
    "enem:gallery": "node scripts/enem/gallery.mjs",
    "enem:import": "node --import ./scripts/local-env.mjs scripts/enem/import.mjs",
    "enem:test": "python -m unittest discover -s scripts/enem",
    "test:scroll": "node --import ./scripts/local-env.mjs scripts/test-scroll.mjs",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/math/generator.test.ts src/lib/math/geometry.test.ts src/lib/multiplayer/store.test.ts src/lib/momentum.test.ts src/lib/auth/auth.test.ts src/lib/profile/profile.test.ts src/lib/scroll/scroll.test.ts scripts/learning/content.test.mjs",
    "learning:validate": "node scripts/learning/import.mjs",
    "learning:import": "node --import ./scripts/local-env.mjs scripts/learning/import.mjs",
    "learning:reports": "node --import ./scripts/local-env.mjs scripts/learning/reports.mjs",
    "test:learning": "node --import ./scripts/local-env.mjs scripts/test-learning.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
